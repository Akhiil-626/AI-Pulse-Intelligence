# AI Pulse Environment Configuration Template
# Phase 1 does not require paid API keys or cloud services.
# Copy this file to .env when local configuration is required.

# Application Settings
APP_ENV=development
APP_PORT=8501

# Ingestion API Settings (Phase 3.1 & 3.2)
# Port 8001 is used to avoid port 8000 collisions with other local containers.
INGEST_API_PORT=8001
# Generate a secure random token for local use (e.g., openssl rand -hex 32)
INGEST_API_TOKEN=fake_dev_token_do_not_use_in_production_123456789
